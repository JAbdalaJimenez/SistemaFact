# PostgreSQL / Supabase Database Connections
# Transaction pooler (port 6543) for serverless queries:
DATABASE_URL="postgresql://postgres.CHANGE_ME:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / direct connection (port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres.CHANGE_ME:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Public Credentials (safe for browser / client bundle)
NEXT_PUBLIC_SUPABASE_URL="https://CHANGE_ME.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="CHANGE_ME"

# Supabase Server-Only Admin Key
# CRÍTICO: SUPABASE_SERVICE_ROLE_KEY JAMÁS debe llevar el prefijo NEXT_PUBLIC_.
# Solo debe usarse en el servidor (rutas API administrativas y scripts).
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago Credentials (opcionales si se configuran por tenant en la DB)
MERCADO_PAGO_ACCESS_TOKEN="CHANGE_ME"
MERCADO_PAGO_PUBLIC_KEY="CHANGE_ME"
MERCADO_PAGO_WEBHOOK_SECRET="CHANGE_ME"

# Clave de cifrado AES-256-GCM en reposo (32 bytes en hex = 64 caracteres hexadecimales)
ENCRYPTION_KEY="CHANGE_ME"
